# Optional. Copy to mobile/.env.local (git-ignored).
# Only EXPO_PUBLIC_* values reach the app and they are visible to users,
# so never put secrets here.
#
# Leave unset to auto-detect: in GitHub Codespaces the app swaps its own
# forwarded port (8081) for 3000; elsewhere on the web it uses <host>:3000.
# EXPO_PUBLIC_API_URL=https://your-api.example.com
