# Copy this file to .env.local (git-ignored) and fill in your own values.
# Read by the backend: npm run dev / npm start / npm run db:migrate.

# Neon (or any PostgreSQL) connection string. Required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Signs login tokens. Required in production (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

NODE_ENV=development
PORT=3000

# Optional: comma-separated list of allowed browser origins. Unset = allow all.
# CORS_ORIGINS=http://localhost:8081,https://your-frontend.example.com

# Optional, development only: also return the demo OTP in the API response so
# the web app can show it (ignored when NODE_ENV=production).
# DEMO_OTP_IN_RESPONSE=true

# Optional: set to false for a local PostgreSQL without TLS.
# DATABASE_SSL=false
